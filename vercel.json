{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/generate-audio",
      "destination": "/api/generate-audio.js"
    },
    {
      "source": "/api/proxy-image",
      "destination": "/api/proxy-image.js"
    },
    {
      "source": "/api/check-policy",
      "destination": "/api/check-policy.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}

